rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    
    function isValidProject(data) {
      return data.keys().hasAll(['id', 'name', 'userId', 'createdAt'])
        && data.id is string
        && data.name is string
        && data.userId == request.auth.uid;
    }
    
    function isValidTechnician(data) {
      return data.keys().hasAll(['id', 'userId', 'name'])
        && data.id is string
        && data.userId == request.auth.uid
        && data.name is string;
    }
    
    function isValidCatalog(data) {
      return data.keys().hasAll(['userId', 'prices'])
        && data.keys().hasOnly(['userId', 'prices'])
        && data.userId == request.auth.uid
        && data.prices is map;
    }

    function isValidPoleModel(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'items'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'items'])
        && data.id is string
        && data.userId == request.auth.uid
        && data.name is string
        && data.items is list;
    }

    // --- Collection Rules ---

    match /projects/{projectId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(projectId) && isValidProject(incoming());
      allow update: if isSignedIn() && isValidProject(incoming()) 
                    && existing().userId == request.auth.uid
                    && incoming().userId == existing().userId
                    && incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /technicians/{technicianId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(technicianId) && isValidTechnician(incoming());
      allow update: if isSignedIn() && isValidTechnician(incoming())
                    && existing().userId == request.auth.uid
                    && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    match /catalogs/{userId} {
      allow get: if isSignedIn() && userId == request.auth.uid;
      allow create: if isSignedIn() && userId == request.auth.uid && isValidCatalog(incoming());
      allow update: if isSignedIn() && userId == request.auth.uid && isValidCatalog(incoming());
      allow delete: if false; // Catalogs should generally be cleared rather than deleted
    }

    match /pole_models/{modelId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(modelId) && isValidPoleModel(incoming());
      allow update: if isSignedIn() && isValidPoleModel(incoming())
                    && existing().userId == request.auth.uid
                    && incoming().userId == existing().userId;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
